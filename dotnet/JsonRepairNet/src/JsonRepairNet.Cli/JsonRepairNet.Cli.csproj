<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>JsonRepairNet.Cli</RootNamespace>
    <AssemblyName>json-repair</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>json-repair</ToolCommandName>
    <PackageId>JsonRepairNet.Cli</PackageId>
    <Version>0.1.1</Version>
    <Authors>lifeme2027</Authors>
    <Description>Unofficial .NET port of json_repair: Dotnet tool that repairs malformed JSON. Command name: json-repair.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lifeme2027/json_repair</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lifeme2027/json_repair</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>json;repair;llm;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonRepairNet\JsonRepairNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JsonRepairNet.Tests" />
  </ItemGroup>

</Project>
